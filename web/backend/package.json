{
  "name": "kbagent-web-backend",
  "version": "0.1.0",
  "description": "Backend-for-frontend that proxies the kbagent serve HTTP API to the React UI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^9.0.0",
    "fastify": "^5.8.5",
    "pino-pretty": "^13.1.3",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
